QWidget {
    background: #353535;
    color: #ffffff;
}

QMainWindow {
    background: #353535;
}

QDialog {
    background: #2b2b2b;
}

QMenuBar {
    background: #353535;
    color: #ffffff;
}

QMenuBar::item:selected {
    background: #2a82da;
    color: #000000;
}

QMenu {
    background: #353535;
    color: #ffffff;
    border: 1px solid #4a4a4a;
}

QMenu::item:selected {
    background: #2a82da;
    color: #000000;
}

QLabel {
    color: #ffffff;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QAbstractSpinBox {
    background: #191919;
    color: #ffffff;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 6px;
}

QPushButton {
    background: #444444;
    color: #ffffff;
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #505050;
}

QPushButton:pressed {
    background: #2a82da;
    color: #000000;
}

QPushButton#primaryActionButton {
    background: #2a82da;
    color: #ffffff;
    border: 1px solid #1f5f9f;
    border-radius: 5px;
    padding: 7px 12px;
    font-weight: 600;
}

QPushButton#primaryActionButton:hover {
    background: #4a9bea;
}

QPushButton#primaryActionButton:pressed {
    background: #1f5f9f;
    color: #ffffff;
}

QPushButton#primaryActionButton:disabled {
    background: #3a4a5a;
    color: #bfc9d4;
    border: 1px solid #485868;
}

QTreeView,
QListView,
QTableView,
QTextEdit,
QPlainTextEdit {
    background: #191919;
    color: #ffffff;
    alternate-background-color: #353535;
    border: 1px solid #4d4d4d;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: #2a82da;
    color: #000000;
}

QStatusBar {
    background: #353535;
    color: #ffffff;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: #2a82da;
    color: #ffffff;
    padding: 6px 8px;
    border-bottom: 1px solid #1f5f9f;
}

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    background: #4a4a4a;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #2a82da;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::groove:vertical {
    background: #4a4a4a;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #2a82da;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}

QCheckBox {
    spacing: 6px;
}

QFrame#viewerControlsSeparator {
    background: #4a4a4a;
    max-width: 1px;
}

QLabel#appDialogBrandLabel {
    color: #8fb7ff;
    font-size: 14px;
    font-weight: 700;
}

QLabel#appDialogTitleLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QLabel#appDialogMessageLabel {
    color: #d8d8d8;
    font-size: 13px;
}

QWidget#viewerToolOverlay,
QWidget#viewerCineOverlay {
    background: #2b2b2b;
    border: 1px solid #5a5a5a;
    border-radius: 8px;
}

QToolButton#viewerToolButton,
QToolButton#viewerCinePlayButton {
    background: #3a3a3a;
    color: #ffffff;
    border: 1px solid #5a5a5a;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton#viewerToolButton:hover,
QToolButton#viewerCinePlayButton:hover {
    background: #4a4a4a;
}

QToolButton#viewerToolButton:checked,
QToolButton#viewerCinePlayButton:checked {
    background: #2a82da;
    border: 1px solid #1f5f9f;
}

QLabel#viewerOverlayTitleLabel {
    color: #d8d8d8;
    font-size: 11px;
    font-weight: 700;
}

QLabel#viewerSliceLabel {
    color: #ffffff;
    font-weight: 600;
    min-width: 56px;
}
